      "inputSchema": {
        "type": "object",
        "properties": {
          "courseIds": {
            "minItems": 1,
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "academicYear": {

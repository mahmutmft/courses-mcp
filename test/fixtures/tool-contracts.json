    {
      "name": "set_lab_term_preference",
      "inputSchema": {
        "type": "object",
        "properties": {
          "courseId": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "term": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "weekday": {
                    "default": null,
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "monday",
                          "tuesday",
                          "wednesday",
                          "thursday",
                          "friday",
                          "saturday",
                          "sunday"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "startTime": {
                    "default": null,
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "endTime": {
                    "default": null,
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "room": {
                    "default": null,
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 16,
                        "pattern": "^[\\p{L}\\p{N}-]+$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "group": {
                    "default": null,
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 16,
                        "pattern": "^[\\p{L}\\p{N}-]+$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "choiceId": {
                    "default": null,
                    "anyOf": [
                      {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "courseId",
          "term"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
